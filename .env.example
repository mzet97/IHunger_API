# ============================================
# IHunger API - Environment Variables
# Copy this file to .env and customize
# ============================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ihunger
POSTGRES_PORT=5432

# pgAdmin (use --profile tools to enable)
PGADMIN_EMAIL=admin@ihunger.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# API
ASPNETCORE_ENVIRONMENT=Docker
API_HTTP_PORT=5000
JWT_SECRET=SXN1bmdFUjEyMzQ1Njc4OTAxMjM0NTY3ODkw
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=IHunger
JWT_VALID_ON=http://localhost:5000

# Redis (use --profile cache to enable)
REDIS_PORT=6379
